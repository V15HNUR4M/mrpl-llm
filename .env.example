# ==============================================================================
# MRPL Sovereign On-Premise Agentic AI Workbench - Production Configuration
# ==============================================================================

# Deployment Environment ('production', 'development', 'testing')
ENVIRONMENT=production

# Cryptographic Secret Key (MUST be at least 32 characters in production)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-this-to-a-cryptographically-secure-32-plus-character-secret-key

# Initial Administrator Bootstrap Credentials
# In production, password must be at least 10 characters and non-default.
FIRST_SUPERUSER=admin
FIRST_SUPERUSER_PASSWORD=ChangeThisStrongBootstrapPassword2026!

# Model Gateway & Local Ollama Runtime
OLLAMA_BASE_URL=http://ollama:11434
DEFAULT_CHAT_MODEL=llama3.2:latest
DEFAULT_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_PROVIDER=ollama

# Database Connection (Stored in persistent named volume)
SQLITE_URL=sqlite+aiosqlite:///./data/mrpl.db

# Storage Paths (Inside /app/data persistent volume)
UPLOAD_DIR=/app/data/uploads
ATTACHMENT_DIR=/app/data/attachments
VECTOR_DB_PATH=/app/data/chroma
MAX_UPLOAD_SIZE=10485760

# Production Security & API Surface
ENABLE_OPENAPI=false
ENABLE_TEST_ENDPOINTS=false
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:80","http://127.0.0.1:80"]
